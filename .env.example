# Base URL of the wallet-platform API. Leave unset in development: the Vite dev server proxies /backend
# to http://localhost:8080 (override the target with BACKEND_URL). Set it for production builds, e.g.
# VITE_API_URL=https://api.example.com  (that origin's frontend must be in the backend's CORS_ALLOWED_ORIGINS)
VITE_API_URL=
